# Copy to .env and adjust. All values shown are the defaults.

# Ollama endpoint. Cloud-tagged chat models (e.g. gemma3:31b-cloud) are served
# through your local Ollama daemon after `ollama signin`.
OLLAMA_BASE_URL=http://localhost:11434

# Chat model for the ghost. Use exactly the tag shown by `ollama list`.
CHAT_MODEL=gemma3:31b-cloud

# Embedding model: must be pulled locally (`ollama pull nomic-embed-text`).
EMBED_MODEL=nomic-embed-text

# Relevance gate (relevance = 1 - cosine distance). With nomic-embed-text every question scores
# about 0.55-0.65, on-topic or not, so the chat model does the grading and these only catch the
# extremes. See `make probe Q="..."`.
GRADE_HIGH=0.95
GRADE_LOW=0.30

# Flask
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
